# ─────────────────────────────────────────────────────────────
#  Plint · Caddyfile
#  One wildcard certificate, one site block per service.
#  Caddy runs on the host network, so every upstream is localhost.
# ─────────────────────────────────────────────────────────────
{
	email admin@{$DOMAIN}
	# Nothing here is public. Only LAN and tailnet clients ever reach this.
	servers {
		trusted_proxies static private_ranges
	}
}

# Reusable snippet: wildcard cert via Cloudflare DNS challenge.
(wildcard) {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
		resolvers 1.1.1.1 1.0.0.1
	}
	encode zstd gzip
	header {
		# No search engines, no referrer leakage, no sniffing.
		X-Robots-Tag "noindex, nofollow"
		Referrer-Policy "same-origin"
		X-Content-Type-Options "nosniff"
		-Server
	}
}

# Plint Terminal: the look of every app.
# (theme-files) serves /_plint/* from theme/ plus the live data the pages read.
(theme-files) {
	header /_plint/* Cache-Control "no-cache"
	# Up/down for the Plint strip, from Uptime Kuma's public status page.
	handle /_plint/health {
		rewrite * /api/status-page/heartbeat/plint
		reverse_proxy localhost:3001
	}
	handle /_plint/monitors {
		rewrite * /api/status-page/plint
		reverse_proxy localhost:3001
	}
	# Written by scripts/theme-data.sh every two minutes.
	handle /_plint/data/* {
		uri strip_prefix /_plint/data
		root * /srv/plint-data
		file_server
	}
	handle /_plint/* {
		root * /srv
		file_server
	}
}

# (theme) also slips the shared sheet, the app's own sheet and plint.js into
# every HTML page. Usage:
#   import theme <app>         (app = the file name under theme/apps/)
# The upstream must answer uncompressed so the page can be rewritten:
#   reverse_proxy … { header_up Accept-Encoding identity }
(theme) {
	import theme-files
	replace {
		match {
			header Content-Type text/html*
		}
		"</head>" "<link rel=\"stylesheet\" href=\"/_plint/plint.css\"><link rel=\"stylesheet\" href=\"/_plint/apps/{args[0]}.css\"><script src=\"/_plint/plint.js\" data-app=\"{args[0]}\" defer></script></head>"
	}
}

# ── Home screen ──────────────────────────────────────────────
{$DOMAIN}, dash.{$DOMAIN} {
	import wildcard
	import theme-files
	# The home page is theme/home: the instruments, then every unit.
	handle {
		header Cache-Control "no-cache"
		rewrite * /_plint/home/index.html
		root * /srv
		file_server
	}
}

# ── One block for every subdomain ────────────────────────────
*.{$DOMAIN} {
	import wildcard

	@dns host dns.{$DOMAIN}
	handle @dns {
		import theme adguard
		reverse_proxy localhost:3000 {
			header_up Accept-Encoding identity
		}
	}

	@host host host.{$DOMAIN}
	handle @host {
		# cockpit.conf sets AllowUnencrypted + ProtocolHeader for this.
		import theme cockpit
		reverse_proxy localhost:9090 {
			header_up Accept-Encoding identity
		}
	}

	@games host games.{$DOMAIN}
	handle @games {
		reverse_proxy localhost:8080
	}

	@stremio host stremio.{$DOMAIN}
	handle @stremio {
		reverse_proxy localhost:8095
	}

	@stacks host stacks.{$DOMAIN}
	handle @stacks {
		import theme dockge
		reverse_proxy localhost:5001 {
			header_up Accept-Encoding identity
		}
	}

	@metrics host metrics.{$DOMAIN}
	handle @metrics {
		import theme beszel
		reverse_proxy localhost:8090 {
			header_up Accept-Encoding identity
		}
	}

	@status host status.{$DOMAIN}
	handle @status {
		import theme kuma
		reverse_proxy localhost:3001 {
			header_up Accept-Encoding identity
		}
	}

	@ntfy host ntfy.{$DOMAIN}
	handle @ntfy {
		import theme ntfy
		# ntfy's service worker serves "/" from a precached app.html; bump its
		# revision so phones that installed it fetch the themed page again.
		replace /sw.js {
			"\",\"url\":\"app.html\"}" "-plint\",\"url\":\"app.html\"}"
		}
		reverse_proxy localhost:8070 {
			header_up Accept-Encoding identity
		}
	}

	@cnc host cnc.{$DOMAIN}
	handle @cnc {
		# CNC Studio. Own look; drawings/PDFs for Claude and saved target models
		# ride in the request, and answers stream for minutes, so no buffering.
		request_body {
			max_size 300MB
		}
		reverse_proxy localhost:5178 {
			flush_interval -1
		}
	}

	@poly host poly.{$DOMAIN}
	handle @poly {
		# Polybot (apps/polybot): the page and its JSON come from the bot itself.
		import theme poly
		reverse_proxy localhost:5190 {
			header_up Accept-Encoding identity
		}
	}

	@accrete host accrete.{$DOMAIN}
	handle @accrete {
		# Accrete (apps/accrete): an incremental game, a star from dust. Own look;
		# the game runs and is saved in the browser, the container hands out files.
		reverse_proxy localhost:5240
	}

	@chimera host chimera.{$DOMAIN}
	handle @chimera {
		# Chimera (apps/chimera): a voice from a simulated airway. Own look; the page
		# runs the engine in the browser, /api/speak renders a WAV on Plint.
		reverse_proxy localhost:5270
	}

	@stocks host stocks.{$DOMAIN}
	handle @stocks {
		# Stocks (apps/stocks): stock-trading models on paper, side by side. The page and
		# its JSON come from the app itself; nothing in it can place a real order.
		import theme stocks
		reverse_proxy localhost:5250 {
			header_up Accept-Encoding identity
		}
	}

	@spider host spider.{$DOMAIN}
	handle @spider {
		# SpiderFoot (stack spider): OSINT scans. Ready-made, its own look, no login.
		reverse_proxy localhost:5260
	}

	@ultron host ultron.{$DOMAIN}
	handle @ultron {
		# Ultron (apps/ultron): a companion you talk to. celeris-1 or Haiku thinks,
		# VoiceStudio on the PC speaks in the cloned voice. Own look; the answer streams.
		reverse_proxy localhost:5230 {
			flush_interval -1
		}
	}

	@ai host ai.{$DOMAIN}
	handle @ai {
		# Plint Chat (apps/plint-chat, native systemd unit): Claude-style page
		# driving Claude Code on Silk models. Own look; streams over SSE.
		reverse_proxy localhost:5220 {
			flush_interval -1
		}
	}

	@speed host speed.{$DOMAIN}
	handle @speed {
		import theme speedtest
		reverse_proxy localhost:8075 {
			header_up Accept-Encoding identity
		}
	}

	@backup host backup.{$DOMAIN}
	handle @backup {
		import theme kopia
		reverse_proxy localhost:51515 {
			header_up Accept-Encoding identity
		}
	}

	# Anything else under the wildcard goes home.
	handle {
		redir https://{$DOMAIN}{uri} 302
	}
}
