#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────
#  plint · the one command for the box
#
#    plint status            what's running, what isn't
#    plint up|down|restart   [stack]   (core | ops | media | all)
#    plint logs <name>       follow a container's logs
#    plint sync              pull the repo, apply any changes
#    plint update            update images + OS packages, then sync
#    plint backup            snapshot now
#    plint doctor            check DNS, certs, ports, tailscale
#    plint claude            attach to Claude on the box (Ctrl+B, D to leave)
#    plint notify "msg"      push a message to your phone
#    plint game [start|stop <name>]   AMP game servers (list · start · stop)
#    plint retro add <platform> <url|file> · plint retro scan   RomM library
# ─────────────────────────────────────────────────────────────
set -euo pipefail
PLINT_DIR="${PLINT_DIR:-/opt/plint}"
# shellcheck source=../scripts/lib.sh
source "${PLINT_DIR}/scripts/lib.sh"
load_env 2>/dev/null || true

STACKS=(core ops media)
usage() { sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

stacks_for() { case "${1:-all}" in all) printf '%s\n' "${STACKS[@]}";; core|ops|media) echo "$1";; *) die "unknown stack: $1";; esac; }

cmd_status() {
  printf '%s%s%s\n\n' "$C_BOLD" "Plint · $(hostname) · $(date '+%a %d %b %H:%M')" "$C_RESET"
  printf '%-16s %-12s %s\n' "SERVICE" "STATE" "WHERE"
  while IFS='|' read -r name state; do
    [[ -z "$name" ]] && continue
    local dot="$C_GREEN●"; [[ "$state" != running* ]] && dot="$C_RED●"
    printf '%s %-14s %-12s %s\n' "$dot$C_RESET" "$name" "$state" "$(url_for "$name")"
  done < <(docker ps -a --format '{{.Names}}|{{.State}}' | sort)
  for svc in cockpit.socket tailscaled plint-claude; do
    local st; st="$(systemctl is-active "$svc" 2>/dev/null || true)"
    local dot="$C_GREEN●"; [[ "$st" != active ]] && dot="$C_YELLOW●"
    printf '%s %-14s %-12s %s\n' "$dot$C_RESET" "${svc%.socket}" "$st" "$(url_for "$svc")"
  done
  if id amp >/dev/null 2>&1; then
    local n; n="$(amp_running | wc -l)"
    printf '%s %-14s %-12s %s\n' "$C_GREEN●$C_RESET" "amp" "${n} running" "https://games.${DOMAIN:-}"
  fi
  printf '\n%s' "$C_DIM"
  df -h / | awk 'NR==2{printf "disk %s used of %s  ·  ", $3, $2}'
  free -h | awk 'NR==2{printf "mem %s of %s  ·  ", $3, $2}'
  uptime -p | sed 's/^up /up /'
  printf '%s\n' "$C_RESET"
}

url_for() {
  case "$1" in
    homepage) echo "https://${DOMAIN:-}";;
    adguard) echo "https://dns.${DOMAIN:-}";;
    dockge) echo "https://stacks.${DOMAIN:-}";;
    beszel) echo "https://metrics.${DOMAIN:-}";;
    uptime-kuma) echo "https://status.${DOMAIN:-}";;
    ntfy) echo "https://ntfy.${DOMAIN:-}";;
    kopia) echo "https://backup.${DOMAIN:-}";;
    stremio) echo "https://stremio.${DOMAIN:-}";;
    cockpit.socket) echo "https://host.${DOMAIN:-}";;
    tailscaled) tailscale ip -4 2>/dev/null | head -n1;;
    plint-claude) echo "claude.ai/code → Plint";;
    *) echo "";;
  esac
}

# ── AMP game servers ─────────────────────────────────────────
# ampinstmgr only starts/stops instance *panels*; a game server is the child process of
# its instance's AMP process. With no API login on the box, start/stop flips the
# instance's AMP.AppStartupMode for one panel restart, then puts it back
# (values: DoNothing · StartApplication · UpdateApplication · UpdateAndStart).
AMP_INSTANCES="$(getent passwd amp 2>/dev/null | cut -d: -f6)/.ampdata/instances"
amp() { sudo -u amp -H "$@"; }

amp_table() {   # instance|friendly name|module
  amp ampinstmgr status 2>/dev/null | awk -F'│' 'NF >= 6 && $1 !~ /Instance Name/ {
    for (i = 1; i <= 3; i++) gsub(/^ +| +$/, "", $i); print $1 "|" $2 "|" $3 }'
}

amp_running() {   # instances whose game server is up
  local pid exe
  while read -r pid exe; do
    pgrep -P "$pid" >/dev/null && basename "$(dirname "$exe")"
  done < <(ps -u amp -o pid=,args= | awk '$2 ~ /\/instances\/[^\/]+\/AMP_Linux_x86_64$/ {print $1, $2}')
  return 0
}

amp_server_pid() {
  local p; p="$(ps -u amp -o pid=,args= | awk -v exe="$AMP_INSTANCES/$1/AMP_Linux_x86_64" '$2 == exe {print $1; exit}')"
  [[ -n "$p" ]] && pgrep -P "$p" | head -n1
  return 0
}

amp_ports() { sudo ss -Hltnp | awk -v p="pid=$1," 'index($0, p) {n = split($4, a, ":"); print a[n]}' | sort -un; }

amp_players() {   # inbound, non-loopback TCP connections to the server's listening ports
  local ports; ports=" $(amp_ports "$1" | tr '\n' ' ')"
  sudo ss -Htn state established | awk -v ports="$ports" '$4 !~ /^(127\.|\[::1\]|\[::ffff:127\.)/ {
    n = split($3, a, ":"); if (index(ports, " " a[n] " ")) c++ } END {print c + 0}'
}

amp_resolve() {   # Nissesky01 · nissesky · "nisse sky" → Nissesky01
  local q="${1,,}" inst name module hits=()
  q="${q// /}"
  [[ -n "$q" ]] || die "which server? see: plint game"
  while IFS='|' read -r inst name module; do
    [[ "$module" == ADS ]] && continue
    name="${name,,}"; name="${name// /}"
    if [[ "${inst,,}" == "$q" || "$name" == "$q" ]]; then echo "$inst"; return; fi
    [[ "${inst,,}" == "$q"* || "$name" == "$q"* ]] && hits+=("$inst")
  done < <(amp_table)
  (( ${#hits[@]} == 1 )) || die "no single server matches '$1' — see: plint game"
  echo "${hits[0]}"
}

amp_mode() {   # amp_mode <instance> [mode]: print the startup mode, or set it
  local conf="$AMP_INSTANCES/$1/AMPConfig.conf"
  if [[ -n "${2:-}" ]]; then amp sed -i "s/^AMP\.AppStartupMode=.*/AMP.AppStartupMode=$2/" "$conf"
  else amp sed -n 's/^AMP\.AppStartupMode=//p' "$conf"; fi
}

amp_log() { amp bash -c 'ls -t "$1"/AMP_Logs/*.log 2>/dev/null | head -n1' _ "$AMP_INSTANCES/$1"; }

amp_bounce() {   # restart the instance's panel under a one-off startup mode
  local inst="$1" was before log out i
  was="$(amp_mode "$inst")"
  [[ -n "$was" ]] || die "no AMP.AppStartupMode in $inst's AMPConfig.conf"
  before="$(amp_log "$inst")"
  trap 'amp_mode "'"$inst"'" "'"$was"'"' EXIT
  amp_mode "$inst" "$2"
  out="$(amp ampinstmgr -r "$inst" 2>&1)" || { printf '%s\n' "$out" >&2; die "ampinstmgr couldn't restart $inst"; }
  # ampinstmgr returns before AMP reads the mode: wait for the new panel's webserver first
  for i in $(seq 1 60); do
    log="$(amp_log "$inst")"
    [[ "$log" != "$before" ]] && amp grep -q "Webserver started" "$log" && break
    sleep 1
  done
  sleep 5
  amp_mode "$inst" "$was"; trap - EXIT
}

cmd_game() {
  case "${1:-list}" in
    list) cmd_game_list;;
    start|stop) local c="$1"; shift; "cmd_game_$c" "$@";;
    *) die "plint game [start|stop <name>]";;
  esac
}

cmd_game_list() {
  printf '%-16s %-16s %s\n' "INSTANCE" "NAME" "SERVER"
  local inst name module pid ports
  while IFS='|' read -r inst name module; do
    [[ "$module" == ADS ]] && continue
    pid="$(amp_server_pid "$inst")"
    if [[ -n "$pid" ]]; then
      ports="$(amp_ports "$pid" | sed 's/^/:/' | paste -sd' ')"
      printf '%s %-14s %-16s %s\n' "$C_GREEN●$C_RESET" "$inst" "$name" "running ${ports:-(starting)} · $(amp_players "$pid") connected"
    else
      printf '%s %-14s %-16s %s\n' "$C_DIM●$C_RESET" "$inst" "$name" "stopped"
    fi
  done < <(amp_table)
}

cmd_game_start() {
  local inst pid ports="" ready=0 i
  inst="$(amp_resolve "$*")"
  [[ -z "$(amp_server_pid "$inst")" ]] || { ok "$inst is already running"; return; }
  say "starting $inst"
  amp_bounce "$inst" StartApplication
  for i in $(seq 1 150); do   # modpacks take a while
    pid="$(amp_server_pid "$inst")"
    [[ -n "$pid" ]] && ports="$(amp_ports "$pid" | paste -sd' ')"
    if [[ -n "$ports" ]]; then
      # Minecraft opens its port before the world loads; "Done (" means joinable
      if ! amp test -f "$AMP_INSTANCES/$inst/MinecraftModule.kvp" || amp grep -q ']: Done (' "$(amp_log "$inst")"; then
        ready=1; break
      fi
    fi
    sleep 2
  done
  [[ -n "${pid:-}" ]] || die "$inst's panel is up but its server didn't start — check https://games.${DOMAIN:-}"
  (( ready )) || { warn "$inst is running but still loading after 5 min"; return; }
  ok "$inst is up on port $ports"
}

cmd_game_stop() {
  local inst pid n i a force=0 args=()
  for a in "$@"; do [[ "$a" == --force ]] && force=1 || args+=("$a"); done
  inst="$(amp_resolve "${args[*]}")"
  pid="$(amp_server_pid "$inst")"
  [[ -n "$pid" ]] || { ok "$inst isn't running"; return; }
  n="$(amp_players "$pid")"
  (( n == 0 || force )) || die "$inst has $n player connection(s) — add --force to stop anyway"
  say "stopping $inst"
  amp_bounce "$inst" DoNothing
  for i in $(seq 1 30); do [[ -z "$(amp_server_pid "$inst")" ]] && break; sleep 2; done
  [[ -z "$(amp_server_pid "$inst")" ]] || die "$inst's server is still running"
  ok "$inst stopped"
}

# ── RomM (retro games) ───────────────────────────────────────
# ROMs live in <library>/roms/<platform>/ (platform = RomM's folder name: gb gbc gba
# nes snes n64 nds psx …). RomM's watcher only notices files on platforms it already
# knows, so every add queues a scan too — the same job the watcher queues, no login.
ROMM_LIBRARY="${ROMM_LIBRARY:-/mnt/storage/retro}"

cmd_retro() {
  case "${1:-}" in
    add) shift; retro_add "$@";;
    scan) retro_scan;;
    *) die "plint retro add <platform> <url|file> [name] · plint retro scan";;
  esac
}

retro_add() {
  local platform="${1:-}" src="${2:-}" name="${3:-}" dir tmp
  [[ -n "$platform" && -n "$src" ]] || die "plint retro add <platform> <url|file> [name]"
  [[ -n "$name" ]] || name="$(python3 -c 'import sys, urllib.parse as u; print(u.unquote(sys.argv[1]))' "$(basename "${src%%\?*}")")"
  dir="$ROMM_LIBRARY/roms/$platform"
  sudo install -d -o 1000 -g 1000 "$dir"
  if [[ "$src" =~ ^https?:// ]]; then
    tmp="$(mktemp)"
    curl -fL --progress-bar -o "$tmp" "$src" || { rm -f "$tmp"; die "download failed: $src"; }
    sudo install -o 1000 -g 1000 -m 0644 "$tmp" "$dir/$name"; rm -f "$tmp"
  else
    [[ -f "$src" ]] || die "no such file: $src"
    sudo install -o 1000 -g 1000 -m 0644 "$src" "$dir/$name"
  fi
  ok "added $platform/$name"
  retro_scan
}

retro_scan() {
  docker exec -w /backend -e PYTHONPATH=/backend -e PYTHONWARNINGS=ignore romm /src/.venv/bin/python -c '
from config import SCAN_TIMEOUT, TASK_RESULT_TTL
from endpoints.sockets.scan import report_scan_failure, scan_job_meta, scan_platforms
from handler.redis_handler import scan_queue
from handler.scan_handler import ScanType, get_enabled_metadata_sources
scan_queue.enqueue(scan_platforms, platform_ids=[], metadata_sources=get_enabled_metadata_sources(),
    scan_type=ScanType.QUICK, on_failure=report_scan_failure, job_timeout=SCAN_TIMEOUT,
    result_ttl=TASK_RESULT_TTL, meta=scan_job_meta(ScanType.QUICK))' >/dev/null
  ok "scan queued; it shows up on https://retro.${DOMAIN:-} in a minute"
}

cmd_up()      { for s in $(stacks_for "${1:-all}"); do say "up $s"; compose "$s" up -d --remove-orphans; done; }
cmd_down()    { for s in $(stacks_for "${1:-all}"); do say "down $s"; compose "$s" down; done; }
cmd_restart() { for s in $(stacks_for "${1:-all}"); do say "restart $s"; compose "$s" restart; done; }
cmd_logs()    { [[ -n "${1:-}" ]] || die "plint logs <container>"; docker logs -f --tail 200 "$1"; }

cmd_sync() {
  step "Sync"
  local before after
  before="$(git -C "$PLINT_DIR" rev-parse --short HEAD)"
  sudo -u plint -H git -C "$PLINT_DIR" pull --ff-only
  after="$(git -C "$PLINT_DIR" rev-parse --short HEAD)"
  if [[ "$before" == "$after" ]]; then ok "already up to date ($after)"; else ok "$before → $after"; fi
  for s in "${STACKS[@]}"; do compose "$s" up -d --remove-orphans --build; done
  docker exec caddy caddy reload --config /etc/caddy/Caddyfile >/dev/null 2>&1 || true
  local u units=0
  for u in plint-theme-data.service plint-theme-data.timer; do
    if ! cmp -s "$PLINT_DIR/systemd/$u" "/etc/systemd/system/$u"; then
      install -m 0644 "$PLINT_DIR/systemd/$u" /etc/systemd/system/
      units=1
    fi
  done
  if (( units )); then
    systemctl daemon-reload && systemctl enable --now plint-theme-data.timer >/dev/null
  fi
  if ! cmp -s "$PLINT_DIR/systemd/plint-claude.service" /etc/systemd/system/plint-claude.service; then
    install -m 0644 "$PLINT_DIR/systemd/plint-claude.service" /etc/systemd/system/
    systemctl daemon-reload && systemctl restart plint-claude
  fi
  ok "synced"
}

cmd_update() {
  step "Update"
  for s in "${STACKS[@]}"; do compose "$s" pull --quiet; done
  cmd_sync
  docker image prune -f >/dev/null
  if [[ "${1:-}" == "--os" ]]; then
    DEBIAN_FRONTEND=noninteractive apt-get update -qq && apt-get upgrade -y -qq
    [[ -f /var/run/reboot-required ]] && warn "reboot required (plan it around game servers)"
  fi
  "$PLINT_DIR/scripts/notify.sh" "Plint updated" "Containers refreshed on $(hostname)" low "arrows_counterclockwise"
  ok "updated"
}

cmd_backup() {
  step "Backup"
  for src in /sources/plint-data /sources/plint.env /sources/amp; do
    docker exec kopia test -e "$src" 2>/dev/null || continue
    docker exec kopia kopia snapshot create "$src"
  done
  "$PLINT_DIR/scripts/notify.sh" "Backup done" "Kopia snapshot finished on $(hostname)" low "floppy_disk"
}

cmd_doctor() {
  step "Doctor"
  local fails=0
  check() { if "$@" >/dev/null 2>&1; then ok "$*"; else warn "FAILED: $*"; ((fails++)) || true; fi; }
  check dig +short +time=2 "@${SERVER_IP:-127.0.0.1}" "dash.${DOMAIN}"
  check dig +short +time=2 "@${SERVER_IP:-127.0.0.1}" cloudflare.com
  check curl -fsS -o /dev/null --max-time 5 "https://${DOMAIN}"
  check curl -fsS -o /dev/null --max-time 5 "https://dns.${DOMAIN}"
  check docker exec caddy caddy validate --config /etc/caddy/Caddyfile
  check tailscale status
  check systemctl is-active plint-claude
  check bash -c "ss -lnu | grep -q ':53 '"
  local exp
  exp="$(echo | openssl s_client -servername "${DOMAIN}" -connect 127.0.0.1:443 2>/dev/null | openssl x509 -noout -enddate 2>/dev/null | cut -d= -f2 || true)"
  [[ -n "$exp" ]] && say "certificate valid until $exp"
  if (( fails == 0 )); then ok "all good"; else warn "$fails check(s) failed"; fi
}

cmd_claude() {
  systemctl is-active --quiet plint-claude || systemctl start plint-claude
  exec sudo -u plint -H tmux attach -t claude
}

cmd_notify() { "$PLINT_DIR/scripts/notify.sh" "Plint" "$*"; ok "sent"; }

case "${1:-}" in
  status|"") cmd_status;;
  up|down|restart|logs|sync|update|backup|doctor|claude|notify|game|retro) c="$1"; shift; "cmd_$c" "$@";;
  -h|--help|help) usage;;
  *) usage 1;;
esac
