# ─────────────────────────────────────────────────────────────
#  Plint · environment
#  Copy to /opt/plint/.env  (install.sh does this and fills it in)
#  This file is the only place secrets live. It is never committed.
# ─────────────────────────────────────────────────────────────

# Your domain. Every service is <name>.${DOMAIN}; the dashboard is the apex.
DOMAIN=plint.net

# Timezone for every container and the host.
TZ=Europe/Stockholm

# Cloudflare API token with "Zone → DNS → Edit" on ${DOMAIN} only.
# Used by Caddy to prove ownership and fetch the wildcard certificate.
CF_API_TOKEN=

# Admin login seeded into AdGuard Home (and reused by the dashboard widget).
ADMIN_USER=admin
ADMIN_PASSWORD=

# Detected at install time. The LAN IP every *.${DOMAIN} name resolves to.
SERVER_IP=
# The LAN subnet Tailscale advertises so remote devices can reach ${SERVER_IP}.
LAN_CIDR=

# Where Kopia keeps backups. Point this at an external disk if you have one.
BACKUP_PATH=/srv/backups

# Filled in automatically once the Beszel hub has generated its key pair.
BESZEL_KEY=

# User/group the containers write data as (the `plint` user).
PUID=1001
PGID=1001

# Generated by install.sh (Speedtest Tracker's Laravel key; login email for apps that want one)
SPEEDTEST_APP_KEY=
ADMIN_EMAIL=

# The Mac on the TV (tv/ in this repo). Set with:  plint tv register <ip> <key>
# TV_KEY is printed by tv/install.sh on the Mac; Caddy sends it with every request.
TV_IP=
TV_KEY=
