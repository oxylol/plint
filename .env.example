# ─────────────────────────────────────────────────────────────
#  Plint · environment
#  Copy to /opt/plint/.env  (install.sh does this and fills it in)
#  This file is the only place secrets live. It is never committed.
# ─────────────────────────────────────────────────────────────

# Your domain. Every service is <name>.${DOMAIN}; the home page is the apex.
DOMAIN=plint.net

# Timezone for every container and the host.
TZ=Europe/Stockholm

# Cloudflare API token with "Zone → DNS → Edit" on ${DOMAIN} only.
# Used by Caddy to prove ownership and fetch the wildcard certificate.
CF_API_TOKEN=

# Admin login seeded into AdGuard Home, ntfy, Kopia and Speedtest Tracker.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Detected at install time. The LAN IP every *.${DOMAIN} name resolves to.
SERVER_IP=
# The LAN subnet Tailscale advertises so remote devices can reach ${SERVER_IP}.
LAN_CIDR=

# Where Kopia keeps backups. Point this at an external disk if you have one.
BACKUP_PATH=/srv/backups

# Filled in automatically once the Beszel hub has generated its key pair.
BESZEL_KEY=

# User/group the containers write data as (the `plint` user).
PUID=1001
PGID=1001

# Generated by install.sh (Speedtest Tracker's Laravel key; login email for apps that want one)
SPEEDTEST_APP_KEY=
ADMIN_EMAIL=

# Written by scripts/ntfy-setup.sh: the token `plint notify` and the apps send with.
NTFY_TOKEN=

# CNC Studio (cnc.${DOMAIN}): a Claude API key for its assistant.
CNC_ANTHROPIC_API_KEY=

# Plint Chat (ai.${DOMAIN}) through silk-router: one Silk Compute key. Without it the page
# opens but cannot answer. SILK_ROUTER_TOKEN is optional: clients must then send it as their key.
SILK_API_KEY=
SILK_ROUTER_TOKEN=

# Ultron (ultron.${DOMAIN}): celeris-1 is the mind (key from celeris.ai); a Claude API key adds
# Haiku as a second mind (TUNE → MIND on the page). The voice is a VoiceStudio with a GPU on the
# tailnet (the PC; apps/ultron/README.md): its address and key. Without it he answers in text.
CELERIS_API_KEY=
ULTRON_ANTHROPIC_API_KEY=
ULTRON_PC_VOICE_URL=
ULTRON_PC_VOICE_KEY=

# Polybot (poly.${DOMAIN}) runs on paper with no keys at all. Going live and every POLY_*/UD_*/…
# setting are in apps/polybot/README.md; none of them belongs here until Filip asks.

# Stocks (stocks.${DOMAIN}): stock-trading models on paper. Each key missing switches off the part that needs it.
#   ALPACA_*: a free paper account at alpaca.markets (email only) → API keys. Prices; nothing runs without them.
#   STOCKS_ANTHROPIC_API_KEY: a Claude API key for the agent; it stops itself at STK_AGENT_CAP_USD a month (200).
#   SEC_CONTACT: an email address. The SEC asks every script that reads its filings to say who is calling.
ALPACA_API_KEY=
ALPACA_API_SECRET=
STOCKS_ANTHROPIC_API_KEY=
SEC_CONTACT=
