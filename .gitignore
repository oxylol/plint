# secrets and local state never leave the box
.env
stacks/*/.env
data/
*.log
.claude/settings.local.json
stacks/*/compose.override.yaml

__pycache__/

# working notes, design sketches and Claude's worktrees stay on the box
.scratch/
theme/sketch/
.claude/worktrees/

# local test installs of app dependencies
apps/*/node_modules/
