# CNC Studio settings — copy to /etc/cnc-studio.env and chmod 600
PORT=5178
HOST=127.0.0.1

# Claude API key used for every chat request from the app
ANTHROPIC_API_KEY=

# Password for the whole site (browser login). Set this when the site is reachable from the internet.
APP_USER=cnc
APP_PASSWORD=

# Optional: keep the work (job, settings, tool libraries, target model) on the server instead of in each browser
#DATA_DIR=/var/lib/cnc-studio

# Optional: folder with TurnTools.ini / MillTools.millreg copied from CncSimulator5
#CNCSIM_TOOLS_DIR=/opt/cnc-studio/tools
